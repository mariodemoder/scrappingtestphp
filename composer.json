{
  "name": "scrappingtestphp/ticket-scraper",
  "description": "CLI app to fetch and normalize ticket listings from providers.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.1",
    "guzzlehttp/guzzle": "^7.9",
    "symfony/dom-crawler": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit -c phpunit.xml.dist",
    "scrape": "php bin/console scrape"
  },
  "config": {
    "sort-packages": true
  }
}
